{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toggl-waybar-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "secrets": {
    "required": ["RELAY_TOKEN", "TOGGL_USER_ID", "TOGGL_WEBHOOK_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY",
        "class_name": "RelayObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
