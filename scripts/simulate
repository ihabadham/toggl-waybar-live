#!/usr/bin/env node

import { createHmac } from "node:crypto";
import { createServer } from "node:http";
import { mkdtemp, readFile, rm } from "node:fs/promises";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";

const repositoryRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const relayToken = "simulation-relay-token";
const webhookSecret = "simulation-webhook-secret";
const apiToken = "simulation-api-token";
const targetUserId = "303";
const children = new Set();
const temporaryRoot = await mkdtemp(join(tmpdir(), "toggl-waybar-live-simulation-"));
let fakeApiRequests = 0;
let currentEntry = null;
let todayEntries = [];

function assert(condition, message) {
  if (!condition) {
    throw new Error(message);
  }
}

async function unusedPort() {
  const server = createServer();
  await new Promise((resolveListen) => server.listen(0, "127.0.0.1", resolveListen));
  const address = server.address();
  assert(address && typeof address === "object", "Could not reserve a local port");
  const port = address.port;
  await new Promise((resolveClose) => server.close(resolveClose));
  return port;
}

async function waitFor(description, predicate, timeoutMilliseconds = 2_000) {
  const deadline = Date.now() + timeoutMilliseconds;
  while (Date.now() < deadline) {
    if (await predicate()) {
      return;
    }
    await new Promise((resolveWait) => setTimeout(resolveWait, 25));
  }
  throw new Error(`Timed out waiting for ${description}`);
}

function track(child) {
  children.add(child);
  child.once("exit", () => children.delete(child));
  return child;
}

async function terminate(child) {
  if (!child || child.exitCode !== null || child.signalCode !== null) {
    return;
  }
  child.kill("SIGTERM");
  await Promise.race([
    new Promise((resolveExit) => child.once("exit", resolveExit)),
    new Promise((resolveTimeout) => setTimeout(resolveTimeout, 2_000)),
  ]);
  if (child.exitCode === null && child.signalCode === null) {
    child.kill("SIGKILL");
  }
}

async function cleanup() {
  await Promise.all([...children].map((child) => terminate(child)));
  await rm(temporaryRoot, { recursive: true });
}

process.once("SIGINT", () => void cleanup().finally(() => process.exit(130)));
process.once("SIGTERM", () => void cleanup().finally(() => process.exit(143)));

const fakeApiPort = await unusedPort();
const workerPort = await unusedPort();
const fakeApi = createServer((request, response) => {
  fakeApiRequests += 1;
  const expectedAuthorization = `Basic ${Buffer.from(`${apiToken}:api_token`).toString("base64")}`;
  if (request.headers.authorization !== expectedAuthorization) {
    response.writeHead(401).end();
    return;
  }

  response.setHeader("content-type", "application/json");
  response.setHeader("x-toggl-quota-remaining", "28");
  response.setHeader("x-toggl-quota-resets-in", "1800");
  if (request.url?.startsWith("/api/v9/me/time_entries?")) {
    response.end(JSON.stringify(todayEntries));
    return;
  }
  if (request.url === "/api/v9/me/time_entries/current") {
    response.end(JSON.stringify({ data: currentEntry }));
    return;
  }
  response.writeHead(404).end(JSON.stringify({ error: "not_found" }));
});
await new Promise((resolveListen) => fakeApi.listen(fakeApiPort, "127.0.0.1", resolveListen));

const workerUrl = `http://127.0.0.1:${workerPort}`;
const workerArguments = [
  "dev",
  "--config",
  "worker/wrangler.jsonc",
  "--ip",
  "127.0.0.1",
  "--port",
  String(workerPort),
  "--persist-to",
  join(temporaryRoot, "wrangler"),
  "--show-interactive-dev-session",
  "false",
  "--log-level",
  "error",
  "--var",
  `RELAY_TOKEN:${relayToken}`,
  "--var",
  `TOGGL_USER_ID:${targetUserId}`,
  "--var",
  `TOGGL_WEBHOOK_SECRET:${webhookSecret}`,
];

function startWorker() {
  const child = track(
    spawn(join(repositoryRoot, "node_modules/.bin/wrangler"), workerArguments, {
      cwd: repositoryRoot,
      stdio: ["ignore", "pipe", "pipe"],
    }),
  );
  return child;
}

async function waitForWorker() {
  await waitFor(
    "local Worker",
    async () => {
      try {
        return (await fetch(`${workerUrl}/health`)).ok;
      } catch {
        return false;
      }
    },
    10_000,
  );
}

const runtimeEnvironment = {
  ...process.env,
  XDG_RUNTIME_DIR: join(temporaryRoot, "runtime"),
};
const rendererLines = [[], []];

function startRenderer(index) {
  const child = track(
    spawn(process.execPath, [join(repositoryRoot, "client/dist/renderer.js")], {
      cwd: repositoryRoot,
      env: { ...runtimeEnvironment, TOGGL_LABEL_MAX_CHARS: "12" },
      stdio: ["ignore", "pipe", "pipe"],
    }),
  );
  child.stdout.setEncoding("utf8");
  let buffered = "";
  child.stdout.on("data", (chunk) => {
    buffered += chunk;
    const lines = buffered.split("\n");
    buffered = lines.pop() ?? "";
    for (const line of lines) {
      if (line) {
        rendererLines[index].push(JSON.parse(line));
      }
    }
  });
  return child;
}

function latestRendererText(index) {
  return rendererLines[index].at(-1)?.text ?? "";
}

function latestRendererHasClass(index, className) {
  return rendererLines[index].at(-1)?.class?.includes(className) ?? false;
}

async function readRuntimeState() {
  try {
    return JSON.parse(
      await readFile(join(runtimeEnvironment.XDG_RUNTIME_DIR, "toggl-waybar-live/state.json"), "utf8"),
    );
  } catch {
    return null;
  }
}

let eventId = 1;
async function sendWebhook(requestType, payload, signatureSecret = webhookSecret) {
  const now = new Date().toISOString();
  const callbackUrl = `${workerUrl}/webhooks/toggl`;
  const body = JSON.stringify({
    event_id: eventId++,
    created_at: now,
    timestamp: now,
    url_callback: callbackUrl,
    metadata: { request_type: requestType, event_user_id: Number(targetUserId) },
    payload,
  });
  const signature = createHmac("sha256", signatureSecret).update(body).digest("hex");
  return fetch(callbackUrl, {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "x-webhook-signature-256": `sha256=${signature}`,
    },
    body,
  });
}

let worker;
let daemon;
let firstRenderer;
let secondRenderer;
try {
  worker = startWorker();
  await waitForWorker();

  daemon = track(
    spawn(process.execPath, [join(repositoryRoot, "client/dist/daemon.js")], {
      cwd: repositoryRoot,
      env: {
        ...runtimeEnvironment,
        TOGGL_API_TOKEN: apiToken,
        TOGGL_API_BASE_URL: `http://127.0.0.1:${fakeApiPort}`,
        TOGGL_TIMEZONE: "Africa/Cairo",
        TOGGL_RELAY_URL: `ws://127.0.0.1:${workerPort}/ws`,
        TOGGL_RELAY_TOKEN: relayToken,
      },
      stdio: ["ignore", "pipe", "pipe"],
    }),
  );
  await waitFor("daemon connection", async () => (await readRuntimeState())?.connection === "connected", 5_000);
  assert(fakeApiRequests === 2, `Expected 2 startup Toggl requests, received ${fakeApiRequests}`);

  firstRenderer = startRenderer(0);
  secondRenderer = startRenderer(1);

  const startedAt = new Date(Date.now() - 2_000).toISOString();
  const runningEntry = {
    id: 101,
    workspace_id: 202,
    user_id: 303,
    project_id: 404,
    project_name: "Internal",
    description: "Simulation",
    start: startedAt,
    stop: null,
    duration: -1,
  };
  currentEntry = runningEntry;
  todayEntries = [runningEntry];
  const startResponse = await sendWebhook("POST", runningEntry);
  assert(startResponse.status === 204, `Start webhook returned ${startResponse.status}`);

  await waitFor(
    "both running renderers",
    () =>
      rendererLines.every(
        (_lines, index) =>
          latestRendererHasClass(index, "running") && latestRendererText(index).includes("Simulation"),
      ),
  );
  const beforeTick = rendererLines.map((_lines, index) => latestRendererText(index));
  const requestsBeforeTick = fakeApiRequests;
  await waitFor(
    "both local timer increments",
    () => rendererLines.every((_lines, index) => latestRendererText(index) !== beforeTick[index]),
  );
  assert(fakeApiRequests === requestsBeforeTick, "Timer tick made an unexpected Toggl request");

  const invalidResponse = await sendWebhook(
    "PATCH",
    { ...runningEntry, description: "Invalid signature" },
    "wrong-secret",
  );
  assert(invalidResponse.status === 401, `Invalid webhook returned ${invalidResponse.status}`);
  await new Promise((resolveWait) => setTimeout(resolveWait, 100));
  assert(
    rendererLines.every((_lines, index) => !latestRendererText(index).includes("Invalid")),
    "Invalid HMAC changed renderer state",
  );

  const stoppedAt = new Date().toISOString();
  const stoppedEntry = {
    ...runningEntry,
    stop: stoppedAt,
    duration: Math.max(0, Math.floor((Date.parse(stoppedAt) - Date.parse(startedAt)) / 1_000)),
  };
  currentEntry = null;
  todayEntries = [stoppedEntry];
  const stopResponse = await sendWebhook("PATCH", stoppedEntry);
  assert(stopResponse.status === 204, `Stop webhook returned ${stopResponse.status}`);
  await waitFor(
    "both idle renderers",
    () => rendererLines.every((_lines, index) => latestRendererHasClass(index, "idle")),
  );

  todayEntries = [];
  const deleteResponse = await sendWebhook("DELETE", { id: 101, wid: 202, uid: 303 });
  assert(deleteResponse.status === 204, `Delete webhook returned ${deleteResponse.status}`);
  await waitFor(
    "deleted entry total",
    () =>
      rendererLines.every(
        (_lines, index) =>
          latestRendererHasClass(index, "idle") && latestRendererText(index).includes("00:00:00"),
      ),
  );

  await terminate(worker);
  worker = null;
  await waitFor("stale state", async () => (await readRuntimeState())?.connection === "stale", 5_000);
  worker = startWorker();
  await waitForWorker();
  await waitFor("reconnected state", async () => (await readRuntimeState())?.connection === "connected", 5_000);

  assert(fakeApiRequests === 2, `Simulation exceeded startup REST budget: ${fakeApiRequests}`);
  assert(firstRenderer.exitCode === null && secondRenderer.exitCode === null, "A renderer exited early");
  process.stdout.write(
    `${JSON.stringify({
      ok: true,
      renderers: 2,
      fakeTogglRequests: fakeApiRequests,
      assertions: ["running", "local_tick", "stop", "invalid_hmac", "delete", "reconnect"],
    })}\n`,
  );
} finally {
  fakeApi.close();
  await cleanup();
}
